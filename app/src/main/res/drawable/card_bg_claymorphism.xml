<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Clay shadow layer -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="0dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#C3B49E" />
        </shape>
    </item>
    <!-- Inflated clay card layer -->
    <item
        android:bottom="3dp"
        android:left="0dp"
        android:right="2dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#F7EFE0" />
            <stroke
                android:width="2dp"
                android:color="#D8C7B0" />
        </shape>
    </item>
</layer-list>
